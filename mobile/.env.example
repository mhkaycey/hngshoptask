# Base URL of the deployed Next.js app (no trailing slash).
# Use your LAN IP instead of localhost when testing on a device (e.g. http://192.168.1.20:3000).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Google OAuth client ID (from the SAME Google Cloud project as the web app).
# Create an OAuth client of type iOS or Android, and add the app's redirect
# URI to its authorized redirect URIs. Run `npx expo start` once and check
# the auth logs (or console.log the `redirectUri` from useAuth) to get the
# exact URI — it looks like `hngshop://` (custom scheme) in a dev build or
# `exp://<ip>:8081` in Expo Go.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
