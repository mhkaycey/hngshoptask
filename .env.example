DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth credentials (Google Cloud Console -> Credentials -> OAuth client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Mailgun (sandbox: https://app.mailgun.com/mg/sandbox)
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_API_BASE=https://api.mailgun.net/v3  # EU: https://api.eu.mailgun.net/v3
MAILGUN_FROM=hngshop <no-reply@your-sandbox-domain.mailgun.org>
# Where contact-form messages are delivered (defaults to MAILGUN_FROM)
SUPPORT_EMAIL=

# Comma-separated list of emails that get role = 'admin'
ADMIN_EMAILS=

# Cloudinary (direct browser uploads, signed server-side)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
